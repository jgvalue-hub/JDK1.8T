<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ include file="head.jspf" %>
<p class="demo-note">데모 명세 작성 · <c:out value="${reportType.formula}"/></p>
<c:if test="${not empty validationError}"><div class="alert" role="alert"><strong>저장하지 못했습니다.</strong> <c:out value="${validationError}"/> 입력 내용은 유지했습니다.</div></c:if>
<c:if test="${empty reviewers}"><div class="alert">다른 활성 매니저/관리자가 없어 저장할 수 없습니다. 관리자에게 검토자 계정 등록·활성화를 요청하세요.<c:if test="${admin}"> <a class="text-link" href="${ctx}/users/edit">사용자 등록</a></c:if></div></c:if>
<form method="post" action="${ctx}/reports/${reportType.code}/save" id="report-form" data-family="${reportType.family}">
<input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="id" value="<c:out value='${record.id}'/>"><input type="hidden" name="version" value="<c:out value='${record.version}'/>">
<section class="panel"><h2>보고서 기본 정보</h2><div class="form-grid"><label>보고서 제목<input name="title" value="<c:out value='${record.title}'/>" required maxlength="120"></label><label>관리 단위 (부서·사업장 등)<input name="business_unit" value="<c:out value='${record.business_unit}'/>" required maxlength="100" placeholder="예: 데모 재무팀"></label><label>시작일<input type="date" name="period_start" value="<c:out value='${record.period_start}'/>" required min="2000-01-01" max="2100-12-31"></label><label>종료일<input type="date" name="period_end" value="<c:out value='${record.period_end}'/>" required min="2000-01-01" max="2100-12-31"></label><label>표시 통화<select name="currency"><c:forEach items="${['KRW','USD','EUR']}" var="cur"><option ${record.currency == cur ? 'selected' : ''}>${cur}</option></c:forEach></select></label><label>지정 검토자<select name="reviewer_id" required><option value="">선택하세요</option><c:forEach items="${reviewers}" var="u"><option value="${u.id}" ${record.reviewer_id == u.selectionKey ? 'selected' : ''}><c:out value="${u.name}"/> (<c:out value="${u.username}"/>)</option></c:forEach></select></label></div><label>검토 메모<textarea name="summary_note" maxlength="2000" rows="3"><c:out value="${record.summary_note}"/></textarea></label></section>
<section class="panel"><div class="section-title"><h2><c:out value="${reportType.dimension}"/>별 입력 명세</h2><div class="line-buttons"><button type="button" id="add-line">+ 행 추가</button><button type="button" id="sample-lines">빈 명세에 데모 예시</button></div></div><p class="muted">1~12행 · 금액은 정수 12자리·소수 4자리 이내. 모든 계산과 검증은 저장 시 서버에서 수행합니다. 행 삭제도 저장해야 반영됩니다.</p>
<div class="table-wrap"><table class="line-editor"><thead><tr><th><c:out value="${reportType.dimension}"/></th><th>분류</th><c:forEach items="${reportType.columns}" var="col"><th><c:out value="${col}"/></th></c:forEach><th>근거·증빙 메모</th><th>관리</th></tr></thead><tbody id="report-lines"><c:forEach items="${lines}" var="line" varStatus="row"><tr><td><input aria-label="${reportType.dimension}" name="lineLabel" value="<c:out value='${line.label}'/>" required maxlength="120"></td><td><select aria-label="명세 분류" name="lineCategory"><c:forEach items="${reportType.categories}" var="cat"><option ${line.category == cat ? 'selected' : ''}><c:out value="${cat}"/></option></c:forEach></select></td><td><input aria-label="${reportType.columns[0]}" type="number" name="lineA" value="<c:out value='${line.amount_a}'/>" min="0" step="0.0001" max="999999999999.9999" required></td><td><input aria-label="${reportType.columns[1]}" type="number" name="lineB" value="<c:out value='${line.amount_b}'/>" min="0" step="0.0001" max="999999999999.9999" required></td><td><input aria-label="${reportType.columns[2]}" type="number" name="lineC" value="<c:out value='${line.amount_c}'/>" min="0" step="0.0001" max="999999999999.9999" required></td><td><input aria-label="명세 메모" name="lineMemo" value="<c:out value='${line.memo}'/>" maxlength="300"></td><td><button class="remove-line danger" type="button">행 삭제</button></td></tr></c:forEach></tbody></table></div><p id="line-status" class="muted" role="status"></p></section>
<div class="actions"><button class="primary" ${empty reviewers ? 'disabled' : ''}>초안 저장</button><a class="button" href="${ctx}/reports/${reportType.code}">취소 · 목록</a><span class="muted">승인 요청은 저장 후 상세 화면에서 진행합니다.</span></div></form>
<%@ include file="foot.jspf" %>
