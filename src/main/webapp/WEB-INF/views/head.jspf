<%@ page pageEncoding="UTF-8" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${title}"/> · Workhub</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><a class="skip" href="#main">본문으로</a><div class="shell"><aside><a class="brand" href="${ctx}/dashboard">W<span>Workhub<small>팀을 연결하는 업무공간</small></span></a><div class="nav-label">WORKSPACE</div><nav><a href="${ctx}/dashboard">◫ 대시보드</a><a href="${ctx}/projects">▤ 프로젝트</a><a href="${ctx}/tasks">✓ 업무</a><a href="${ctx}/clients">▦ 거래처</a><a href="${ctx}/approvals">↗ 내 승인요청</a><c:if test="${manager}"><a href="${ctx}/inbox">▣ 승인함</a></c:if><a href="${ctx}/notices">◉ 공지사항</a><c:if test="${admin}"><div class="nav-label">ADMINISTRATION</div><a href="${ctx}/users">사용자 관리</a><a href="${ctx}/departments">부서 관리</a><a href="${ctx}/audit">감사로그</a></c:if></nav><div class="aside-foot">함께 만드는 더 나은 업무 흐름<br>WORKHUB · 1.0</div></aside><div class="workspace"><header><span>우리 팀의 업무공간</span><div class="account"><a href="${ctx}/profile"><c:out value="${username}"/> · 내 정보</a><form action="${ctx}/logout" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="quiet">로그아웃</button></form></div></header><main id="main"><div class="page-heading"><div><div class="eyebrow">WORKSPACE / <c:out value="${title}"/></div><h1><c:out value="${title}"/></h1></div><span class="workspace-badge">● 연결된 업무</span></div><c:if test="${param.saved != null}"><div class="alert success" role="status">변경사항을 저장했습니다.</div></c:if><c:if test="${param.deleted != null}"><div class="alert success" role="status">자료를 삭제했습니다.</div></c:if>