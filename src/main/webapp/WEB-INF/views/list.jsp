<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ include file="head.jspf" %>
<section class="panel"><div class="toolbar"><form class="search" method="get"><label class="sr-only" for="q">검색어</label><input id="q" name="q" value="<c:out value='${q}'/>" placeholder="${entity == 'audit_log' ? '대상' : '이름 / 제목'} 검색" maxlength="100"><button>검색</button></form><c:if test="${entity != 'audit_log' && entity != 'departments' && entity != 'notices' && !inbox && (entity != 'clients' || manager)}"><a class="button primary" href="${ctx}/${entity}/edit">+ ${titles[entity]} 등록</a></c:if></div><p class="muted">전체 ${total}건 · ${page} / ${pages} 페이지</p><div class="table-wrap"><table><thead><tr><th>번호</th><th>${entity == 'audit_log' ? '대상' : '이름 / 제목'}</th><th>${entity == 'audit_log' ? '수행자 / 동작' : '상태 / 정보'}</th><th>관리</th></tr></thead><tbody><c:forEach items="${rows}" var="r"><tr><td class="muted">${r.id}</td><td><strong><c:out value="${entity == 'audit_log' ? r.target : r.name}"/></strong><c:if test="${entity == 'notices'}"><p class="pre"><c:out value="${r.description}"/></p></c:if></td><td><c:choose><c:when test="${not empty r.status}"><span class="badge">${labels[r.status]}</span></c:when><c:when test="${entity == 'users'}"><c:out value="${labels[r.role]}"/> · ${r.enabled ? '활성' : '비활성'}</c:when><c:when test="${entity == 'clients'}"><c:out value="${r.contact}"/></c:when><c:when test="${entity == 'audit_log'}"><c:out value="${r.actor}"/> / <c:out value="${r.action}"/><small><c:out value="${r.created_at}"/></small></c:when><c:otherwise>—</c:otherwise></c:choose></td><td><c:choose><c:when test="${entity == 'projects' || entity == 'tasks' || entity == 'approvals'}"><a class="text-link" href="${ctx}/${entity}/${r.id}">상세 →</a></c:when><c:when test="${entity == 'users' || (entity == 'clients' && manager)}"><a class="text-link" href="${ctx}/${entity}/edit?id=${r.id}">수정</a></c:when><c:when test="${entity == 'departments' || (entity == 'notices' && manager)}"><details><summary>수정 / 삭제</summary><form method="post" action="${ctx}/${entity}/save"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="id" value="${r.id}"><input type="hidden" name="version" value="${empty r.version ? 0 : r.version}"><label>이름 / 제목<input name="name" value="<c:out value='${r.name}'/>" maxlength="100" required></label><c:if test="${entity == 'notices'}"><label>내용<textarea name="description" maxlength="4000" required><c:out value="${r.description}"/></textarea></label></c:if><button>저장</button></form><form method="post" action="${ctx}/${entity}/${r.id}/delete"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="version" value="${empty r.version ? 0 : r.version}"><label class="confirm"><input type="checkbox" required> 삭제 확인</label><button class="danger">삭제</button></form></details></c:when><c:otherwise>—</c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="4" class="empty">표시할 자료가 없습니다. 검색어를 바꾸거나 새 자료를 등록하세요.</td></tr></c:if></tbody></table></div><div class="pagination"><c:if test="${page > 1}"><c:url var="prev" value="/${path}"><c:param name="q" value="${q}"/><c:param name="page" value="${page-1}"/></c:url><a class="button" href="<c:out value='${prev}'/>">← 이전</a></c:if><span>${page} / ${pages}</span><c:if test="${page < pages}"><c:url var="next" value="/${path}"><c:param name="q" value="${q}"/><c:param name="page" value="${page+1}"/></c:url><a class="button" href="<c:out value='${next}'/>">다음 →</a></c:if></div></section><c:if test="${entity == 'departments' || (entity == 'notices' && manager)}"><section class="panel form-panel"><h2>${titles[entity]} 등록</h2><form method="post" action="${ctx}/${entity}/save"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><%@ include file="fields.jspf" %><button class="primary">등록</button></form></section></c:if>
<%@ include file="foot.jspf" %>